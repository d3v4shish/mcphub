APP_HOST=127.0.0.1
CENTRAL_PORT=8015
MCP_PORT=9015
ASSET_MCP_PORT=9016
THREAT_MCP_PORT=9017
CENTRAL_DATABASE_PATH=data/registry.db
FIREWALL_DATABASE_PATH=mcp_servers/firewall_logs.db
APP_API_KEY=replace-with-a-long-random-value
MCP_SHARED_KEY=replace-with-a-different-long-random-value
