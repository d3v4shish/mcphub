OLLAMA_MODEL=llama3.1:8b
MCP_CONNECT_TIMEOUT_SECONDS=3
MCP_REQUEST_TIMEOUT_SECONDS=20
MCP_TOOL_CALL_TIMEOUT_SECONDS=20
MCP_MAX_RESPONSE_BYTES=262144
AGENT_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_EXECUTION_SECONDS=90
LOG_LEVEL=INFO
